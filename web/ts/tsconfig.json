{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "../static",
    "paths": {
      "preact": ["./third_party/preact/src/index.d.ts"],
      "preact/hooks": ["./third_party/preact/hooks/src/index.d.ts"],
      "preact/jsx-runtime": ["./third_party/preact/jsx-runtime/src/index.d.ts"],
      "lucide-icons": ["./third_party/lucide.d.ts"]
    },
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "third_party",
    "demo",
    "demo-sw.ts"
  ]
}
