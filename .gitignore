# Build output
/mymail
/mymail-lda
/mymail-cli
/mymail-token
/data

# Generated code (regenerated by build.sh — never committed)
*_gen.go
*.gen.go
web/ts/api/types.ts
web/static/**/*.js
!web/static/third_party/**

# Local agent / editor state
/.claude/settings.local.json
/.junie
/.idea
/.playwright
/.playwright-mcp
/.playwright-cli

# Task tracking scratch files
/TODO.md
/DOING.md
/DONE.md

# End to end tests. test-e2e.sh uses a mktemp data directory it removes itself,
# but a server started by hand from e2e/ defaults -data to ./data/.
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/
/e2e/data/
/e2e/.playwright
/e2e/.playwright-mcp
/e2e/.playwright-cli

# Vendor rebuild scratch (web/ts/third_party/rebuild.sh) — throwaway, never committed.
# jsdom can't be bundled, so its install tree is vendored as the committed
# deterministic web/ts/third_party/test/jsdom-node_modules.tar.gz; the extracted
# node_modules/ below is ephemeral (restored by web/ts/third_party/test/unpack.sh at
# test time) and must stay out of git.
/web/ts/third_party/node_modules/
/web/ts/third_party/test/node_modules/

/ignored
